# SPDX-License-Identifier: Apache-2.0

# ElemRV-H Portable Data Logger Test
# Multi-threaded: sensor reads + LED heartbeat + thread analyzer.
# Same source as N test — proves firmware portability.
#
# Build: west build -b elemrv_h app/portable_data_logger -d build-portable-data-logger

using sysbus

mach create "elemrv_h_portable"

machine LoadPlatformDescription @platforms/elemrv_h_i2c_sensor.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../software/elemrv-zephyr/build-portable-data-logger/zephyr/zephyr.elf

# Set sensor values
i2c0.sensor Temperature 22.0
i2c0.sensor Humidity 50.0

log ""
log "=== Portable H Test ==="
log "Board: ElemRV-H (VexRiscv RV32IC @ 50 MHz)"
log "App: portable_data_logger (3 threads)"
log ""

# Run for 5s — enough for 10 samples + reports + thread analyzer
emulation RunFor "00:00:05.000000"

log ""
log "=== Portable H Test PASSED ==="
log ""

quit
