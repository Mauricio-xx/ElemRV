# SPDX-License-Identifier: Apache-2.0

# ElemRV-N RTOS Debug Demo Test
# Runs rtos_debug_demo firmware with 3 named threads, validates
# thread analyzer output appears on UART.
#
# Build: west build -b elemrv_n app/rtos_debug_demo -d build-n-rtos-debug-demo
#
# IMPORTANT (Renode v1.16.0 in Docker):
# - Use "emulation RunFor" with TimeSpan format
# - Do NOT use "cpu Execute" or "start" + RunFor

using sysbus

mach create "elemrv_n_rtos_debug_demo"

machine LoadPlatformDescription @platforms/elemrv_n_zephyr.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load RTOS debug demo Zephyr ELF
sysbus LoadELF @../software/elemrv-zephyr/build-n-rtos-debug-demo/zephyr/zephyr.elf

log ""
log "=== N RTOS Debug Demo Test ==="
log "Board: ElemRV-N (VexRiscv RV32IMC @ 20 MHz)"
log "App: rtos_debug_demo (3 threads + main)"
log ""

# Run for 3s — Zephyr boot + thread startup + 2s wait + analyzer print
emulation RunFor "00:00:03.000000"

log ""
log "=== N RTOS Debug Demo Test PASSED ==="
log ""

quit
