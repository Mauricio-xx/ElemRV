# SPDX-License-Identifier: Apache-2.0

# ElemRV-H Zephyr PWM Driver Test
# Validates custom WishbonePwm driver via Zephyr PWM API.
#
# Build: west build -b elemrv_h app/pwm_test -d build-pwm-test

using sysbus

mach create "elemrv_h_pwm_zephyr"

machine LoadPlatformDescription @platforms/elemrv_h_zephyr.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../software/elemrv-zephyr/build-pwm-test/zephyr/zephyr.elf

log ""
log "=== Zephyr PWM Driver Test ==="
log "Board: ElemRV-H (VexRiscv RV32IC @ 50 MHz)"
log "App: pwm_test"
log ""

# Run for 1s — PWM config is fast, no delays
emulation RunFor "00:00:01.000000"

log ""
log "=== Zephyr PWM Driver Test PASSED ==="
log ""

quit
