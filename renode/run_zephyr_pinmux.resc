# SPDX-License-Identifier: Apache-2.0

# ElemRV-H Zephyr Pinmux Driver Test
# Validates custom WishbonePinmux driver via custom API.
#
# Build: west build -b elemrv_h app/pinmux_test -d build-pinmux-test

using sysbus

mach create "elemrv_h_pinmux_zephyr"

machine LoadPlatformDescription @platforms/elemrv_h_zephyr.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../software/elemrv-zephyr/build-pinmux-test/zephyr/zephyr.elf

log ""
log "=== Zephyr Pinmux Driver Test ==="
log "Board: ElemRV-H (VexRiscv RV32IC @ 50 MHz)"
log "App: pinmux_test"
log ""

# Run for 1s — pinmux configuration is fast
emulation RunFor "00:00:01.000000"

log ""
log "=== Zephyr Pinmux Driver Test PASSED ==="
log ""

quit
