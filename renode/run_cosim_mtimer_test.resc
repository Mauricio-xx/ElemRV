# MachineTimer Co-simulation Register Test
# RISC-V mtime/mtimecmp layout (NOT LiteX timer).
# No IpIdentification. Counter auto-increments every clock cycle.

using sysbus

mach create "elemrv_h_cosim_mtimer"

machine LoadPlatformDescription @platforms/elemrv_h_cosim_mtimer.repl

logLevel 3 sysbus

$mtimer_lib?="/workspace/elemrv/renode/verilated/libs/libmtimer.so"
timer0_cosim SimulationFilePathLinux $mtimer_lib

sysbus WriteDoubleWord 0xA0000000 0x0000006F
cpu PC 0xA0000000
cpu PerformanceInMips 50

log ""
log "=== MachineTimer Co-simulation Register Test ==="
log ""

# Let timer run for 100us (5000 cycles at 50MHz)
emulation RunFor "00:00:00.000100"

# Read mtime — should be non-zero (auto-incrementing counter)
log "mtime_lo     @ 0xF0005000 (expect non-zero):"
sysbus ReadDoubleWord 0xF0005000
log "mtime_hi     @ 0xF0005004 (expect 0x00 for short run):"
sysbus ReadDoubleWord 0xF0005004

# Write mtimecmp and read back
log "Writing mtimecmp_lo = 0x1234..."
sysbus WriteDoubleWord 0xF0005008 0x1234
emulation RunFor "00:00:00.000010"
log "mtimecmp_lo  @ 0xF0005008 (expect 0x1234):"
sysbus ReadDoubleWord 0xF0005008

log "Writing mtimecmp_hi = 0x0000..."
sysbus WriteDoubleWord 0xF000500C 0x0000
emulation RunFor "00:00:00.000010"
log "mtimecmp_hi  @ 0xF000500C (expect 0x0000):"
sysbus ReadDoubleWord 0xF000500C

log ""
log "=== MachineTimer Co-simulation Test PASSED ==="
log ""

quit
