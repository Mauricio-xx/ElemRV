# ElemRV-N Zephyr SPI Quad I/O flash test.
# Loads zephyr.elf and exercises the co-sim flash via:
#   - Zephyr's SPI driver (spi_transceive) for RDID
#   - Direct command-stream pokes for Quad I/O Fast Read

using sysbus

mach create "elemrv_n_spi_quad_flash_zephyr"

machine LoadPlatformDescription @platforms/elemrv_n_cosim_spi_quad_flash.repl

logLevel 3 sysbus

$spi_lib?="/workspace/elemrv/renode/verilated/libs/libspi_quad.so"
spi0_cosim SimulationFilePathLinux $spi_lib

showAnalyzer uart0

sysbus LoadELF @../software/elemrv-zephyr/build-n-spi-quad-flash/zephyr/zephyr.elf

log ""
log "=== N SPI Quad Flash Zephyr Test ==="
log "Board: ElemRV-N (VexRiscv RV32IMC)"
log ""

# Zephyr boot + RDID via spi_transceive + QIO via register pokes.
emulation RunFor "00:00:05.000000"

log ""
log "=== N SPI Quad Flash Zephyr Test Done ==="
log ""

quit
