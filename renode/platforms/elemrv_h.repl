// ElemRV-H Platform Description - WORKING VERSION
// Hydrogen platform - CPU + RAM + FLASH
// CPU: VexRiscv RV32IC @ 50 MHz

// CPU: RISC-V VexRiscv RV32IC
cpu: CPU.VexRiscv @ sysbus
    cpuType: "rv32ic"

// Main RAM: 8 KB @ 0x80000000
ram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x00002000

// FLASH: 64 KB @ 0xA0000000
flash: Memory.MappedMemory @ sysbus 0xA0000000
    size: 0x00010000

// Peripherals to be added:
// - GPIO0 @ 0xF0000000 (12 pins)
// - UART0 @ 0xF0004000
// - I2C0 @ 0xF0001000
// - PWM0 @ 0xF0003000
// - PIO0 @ 0xF0002000
// - Pinmux @ 0xF0010000
