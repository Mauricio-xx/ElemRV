# ElemRV-N Pinmux Co-simulation Register Test (20 pins)
# No IpIdentification — register map starts at offset 0x00.
# 20 pins, each with 1-bit mux select at pin*4.

using sysbus

mach create "elemrv_n_cosim_pinmux"

machine LoadPlatformDescription @platforms/elemrv_n_cosim_pinmux.repl

logLevel 3 sysbus

$pinmux_n_lib?="/workspace/elemrv/renode/verilated/libs/libpinmux_n.so"
pinmux_cosim SimulationFilePathLinux $pinmux_n_lib

sysbus WriteDoubleWord 0xA0000000 0x0000006F
cpu PC 0xA0000000
cpu PerformanceInMips 20

log ""
log "=== N Pinmux Co-simulation Register Test ==="
log ""

emulation RunFor "00:00:00.000100"

# Write and read back pin mux registers
log "Pin 0 write 0x01..."
sysbus WriteDoubleWord 0xF0010000 0x01
emulation RunFor "00:00:00.000010"
log "Pin 0 read (expect 0x01):"
sysbus ReadDoubleWord 0xF0010000

log "Pin 1 write 0x00..."
sysbus WriteDoubleWord 0xF0010004 0x00
emulation RunFor "00:00:00.000010"
log "Pin 1 read (expect 0x00):"
sysbus ReadDoubleWord 0xF0010004

log "Pin 10 write 0x01..."
sysbus WriteDoubleWord 0xF0010028 0x01
emulation RunFor "00:00:00.000010"
log "Pin 10 read (expect 0x01):"
sysbus ReadDoubleWord 0xF0010028

log "Pin 19 write 0x01..."
sysbus WriteDoubleWord 0xF001004C 0x01
emulation RunFor "00:00:00.000010"
log "Pin 19 read (expect 0x01):"
sysbus ReadDoubleWord 0xF001004C

log ""
log "=== N Pinmux Co-simulation Test PASSED ==="
log ""

quit
