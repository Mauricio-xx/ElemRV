# SPDX-License-Identifier: Apache-2.0

# Timer Perturbation Fault Injection Test
# Disables timer IRQ mid-execution via sysbus write to LiteX_Timer_CSR32 ev_enable,
# then observes whether Zephyr timer callbacks stop firing.
#
# LiteX_Timer_CSR32 register map at 0xF0005000:
#   0x00: load        0x04: reload      0x08: en (enable)
#   0x0C: update_value  0x10: value     0x14: ev_status
#   0x18: ev_pending    0x1C: ev_enable (IRQ mask)
#
# Platform: elemrv_h_zephyr.repl (LiteX models).
# Firmware: timer_uart_test Zephyr ELF.

using sysbus

mach create "elemrv_h_fault_timer"

machine LoadPlatformDescription @platforms/elemrv_h_zephyr.repl

logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../software/elemrv-zephyr/build-timer-uart-test/zephyr/zephyr.elf

log ""
log "=== Timer Perturbation Fault Injection Test ==="
log "Board: ElemRV-H (VexRiscv RV32IC @ 50 MHz)"
log "App: timer_uart_test"
log ""

# Step 1: Let Zephyr boot and start timer callbacks
log "Running 200ms for Zephyr boot + initial timer callbacks..."
emulation RunFor "00:00:00.200000"

# Step 2: Fault — disable timer IRQ
log ""
log "--- Fault: Disable Timer IRQ ---"
log "FAULT: Writing 0x00 to ev_enable (0xF000501C) — disabling timer IRQ..."
sysbus WriteDoubleWord 0xF000501C 0x00
emulation RunFor "00:00:00.000010"

# Read back to check if write took effect
log "ev_enable @ 0xF000501C (expect 0x00 if writable):"
sysbus ReadDoubleWord 0xF000501C

# Step 3: Fallback — if ev_enable didn't take, make timer period huge
log ""
log "--- Fallback: Set huge timer load ---"
log "Writing 0xFFFFFFFF to load (0xF0005000) — very long timer period..."
sysbus WriteDoubleWord 0xF0005000 0xFFFFFFFF
emulation RunFor "00:00:00.000010"
log "Writing 0xFFFFFFFF to reload (0xF0005004) — very long reload..."
sysbus WriteDoubleWord 0xF0005004 0xFFFFFFFF
emulation RunFor "00:00:00.000010"

# Step 4: Run for 3 seconds — if IRQ disabled, callbacks should stop
log ""
log "Running 3000ms post-fault — expecting no more timer callbacks..."
emulation RunFor "00:00:03.000000"

# The timer_uart_test firmware prints "Timer-UART Integration Test PASSED"
# only if enough callbacks fire. If the fault worked, that marker will be
# absent — the bash wrapper verifies both:
#   (a) "Timer period" appeared (boot succeeded)
#   (b) "Timer-UART Integration Test PASSED" is absent (fault disrupted)

log ""
log "=== Timer Perturbation Fault Test PASSED ==="
log ""

quit
