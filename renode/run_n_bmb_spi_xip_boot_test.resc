# G.2: image-container boot flow DT test.
# Validates the full image-container pipeline:
#   1. gen_dt_image_container.sh pads xip_boot_test.bin into a 4 KiB image
#   2. BMBXIP_IMAGE_PATH=/.../xip_boot_image.img env var pre-loads it
#      into the flash slave's backing ROM at wrapper init
#   3. XIP reads from the DT's data bank trigger BMB -> SPI -> flash reads
#      that recover the image bytes
#
# The first four instruction words emitted by the RV32IC compile of the
# xip_boot_test firmware are the ground truth:
#   0xF000B000: 0x80000137  (lui sp, 0x80000)
#   0xF000B004: 0x40010113  (addi sp, sp, 1024)
#   0xF000B008: 0xA0012011  (compressed jal main + padding)
#   0xF000B00C: 0xF0006737  (lui a4, 0xf0006  -> UART base)
#
# CPU is parked at RAM to avoid Renode's "execute outside RAM/ROM"
# abort; the test exercises the image path via sysbus reads only.

using sysbus

mach create "elemrv_n_bmb_spi_xip_boot"

machine LoadPlatformDescription @platforms/elemrv_n_bmb_spi_xip_boot.repl

logLevel 3 sysbus

$xip_lib?="/workspace/elemrv/renode/verilated/libs/libbmb_spi_xip.so"
bmb_spi_xip SimulationFilePathLinux $xip_lib

sysbus WriteDoubleWord 0x80000000 0x0000006F
cpu PC 0x80000000
cpu PerformanceInMips 30

log ""
log "=== N BMB SpiXip Image-Container Boot Flow Test ==="
log ""

emulation RunFor "00:00:00.000100"

log "-- Image word 0 @ 0xF000B000 (expect 0x80000137, lui sp) --"
sysbus ReadDoubleWord 0xF000B000
log "-- Image word 1 @ 0xF000B004 (expect 0x40010113, addi sp) --"
sysbus ReadDoubleWord 0xF000B004
log "-- Image word 2 @ 0xF000B008 (expect 0xA0012011) --"
sysbus ReadDoubleWord 0xF000B008
log "-- Image word 3 @ 0xF000B00C (expect 0xF0006737, lui a4 = UART base) --"
sysbus ReadDoubleWord 0xF000B00C

log ""
log "-- ASCII marker at image offset 0x38 (expect 0x20504958 = 'XIP ') --"
sysbus ReadDoubleWord 0xF000B038

log ""
log "=== N BMB SpiXip Image-Container Boot Flow Test PASSED ==="
log ""

quit
