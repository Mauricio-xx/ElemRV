# GDB Debug Session: Bare-metal firmware on base platform (LiteX models)
# Usage:
#   Terminal 1: renode --disable-xwt --console -e "include @debug_bare_metal.resc"
#   Terminal 2: riscv-none-elf-gdb -x gdb/elemrv.gdb software/elemrv_h/pwm_test/pwm_test.elf

using sysbus

mach create "elemrv_debug"

machine LoadPlatformDescription @platforms/elemrv_h.repl

logLevel 3 sysbus

$elf ?= @../software/elemrv_h/pwm_test/pwm_test.elf
sysbus LoadELF $elf
cpu PerformanceInMips 50

machine StartGdbServer 3333 true

log "GDB server listening on port 3333 (bare-metal debug)"
log "Connect with: riscv-none-elf-gdb -x gdb/elemrv.gdb <your_firmware.elf>"
