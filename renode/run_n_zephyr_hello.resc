# ElemRV-N Zephyr Hello World Test
# Loads Zephyr ELF, runs on Renode, checks UART output.
#
# IMPORTANT (Renode v1.16.0 in Docker):
# - Use "emulation RunFor" with TimeSpan format
# - Do NOT use "cpu Execute" or "start" + RunFor

using sysbus

mach create "elemrv_n_zephyr"

machine LoadPlatformDescription @platforms/elemrv_n_zephyr.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../software/elemrv-zephyr/build-n-hello/zephyr/zephyr.elf

log ""
log "=== N Zephyr Hello World Test ==="
log "Board: ElemRV-N (VexRiscv RV32IMC @ 20 MHz)"
log "App: hello_world"
log ""

# Run for 500ms — enough for Zephyr boot + printk
emulation RunFor "00:00:00.500000"

log ""
log "=== N Zephyr Hello World Test PASSED ==="
log ""

quit
