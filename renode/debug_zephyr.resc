# GDB Debug Session: Zephyr RTOS on Zephyr platform (LiteX_Timer_CSR32)
# Usage:
#   Terminal 1: renode --disable-xwt --console -e "include @debug_zephyr.resc"
#   Terminal 2: riscv-none-elf-gdb -x gdb/elemrv.gdb software/elemrv-zephyr/build/zephyr/zephyr.elf

using sysbus

mach create "elemrv_debug_zephyr"

machine LoadPlatformDescription @platforms/elemrv_h_zephyr.repl

logLevel 3 sysbus

showAnalyzer uart0

$elf ?= @../software/elemrv-zephyr/build/zephyr/zephyr.elf
sysbus LoadELF $elf

machine StartGdbServer 3333 true

log "GDB server listening on port 3333 (Zephyr debug)"
log "Connect with: riscv-none-elf-gdb -x gdb/elemrv.gdb <your_zephyr.elf>"
