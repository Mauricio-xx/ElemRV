# Wishbone -> BMB bridge round-trip DT test.
# Writes a 32-bit pattern through the Wishbone port of WishboneBmbBridge
# and reads it back. The internal SimpleBmbRam serves the BMB side.

using sysbus

mach create "elemrv_n_bmb_bridge"

machine LoadPlatformDescription @platforms/elemrv_n_cosim_bmb_bridge.repl

logLevel 3 sysbus

$bmb_lib?="/workspace/elemrv/renode/verilated/libs/libbmb_bridge.so"
bmb_bridge SimulationFilePathLinux $bmb_lib

sysbus WriteDoubleWord 0x80000000 0x0000006F
cpu PC 0x80000000
cpu PerformanceInMips 30

log ""
log "=== N BMB Bridge Co-simulation Test ==="
log ""

emulation RunFor "00:00:00.000100"

# Write a pattern at word offsets 0, 1, 2, 3 (absolute 0xF0008000..).
sysbus WriteDoubleWord 0xF0008000 0xDEADBEEF
sysbus WriteDoubleWord 0xF0008004 0xCAFEF00D
sysbus WriteDoubleWord 0xF0008008 0x12345678
sysbus WriteDoubleWord 0xF000800C 0xA5A5A5A5

emulation RunFor "00:00:00.000100"

log "Read 0xF0008000 (expect 0xDEADBEEF):"
sysbus ReadDoubleWord 0xF0008000
log "Read 0xF0008004 (expect 0xCAFEF00D):"
sysbus ReadDoubleWord 0xF0008004
log "Read 0xF0008008 (expect 0x12345678):"
sysbus ReadDoubleWord 0xF0008008
log "Read 0xF000800C (expect 0xA5A5A5A5):"
sysbus ReadDoubleWord 0xF000800C

log ""
log "=== N BMB Bridge Co-simulation Test PASSED ==="
log ""

quit
