# PWM Register Corruption Fault Injection Test
# Validates: R/W register corruption via sysbus, RO register protection by RTL.
# Platform: full co-sim (all 7 Verilator peripherals, tight-loop CPU).
#
# sysbus WriteDoubleWord to a CoSimulatedPeripheral address routes through
# the Verilator RTL Wishbone bus — reads return real RTL state.

using sysbus

mach create "elemrv_h_fault_pwm"

machine LoadPlatformDescription @platforms/elemrv_h_full_cosim.repl

logLevel 3 sysbus

# Attach all 7 verilated libraries
$gpio_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libgpio.so"
$i2c_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libi2c.so"
$pio_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libpio.so"
$pwm_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libpwm.so"
$uart_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libuart.so"
$mtimer_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libmtimer.so"
$pinmux_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libpinmux.so"
gpio0_cosim SimulationFilePathLinux $gpio_lib
i2c0_cosim SimulationFilePathLinux $i2c_lib
pio0_cosim SimulationFilePathLinux $pio_lib
pwm0_cosim SimulationFilePathLinux $pwm_lib
uart0_cosim SimulationFilePathLinux $uart_lib
timer0_cosim SimulationFilePathLinux $mtimer_lib
pinmux_cosim SimulationFilePathLinux $pinmux_lib

# Set CPU to tight loop (no firmware)
sysbus WriteDoubleWord 0xA0000000 0x0000006F
cpu PC 0xA0000000
cpu PerformanceInMips 50

log ""
log "=== PWM Register Corruption Fault Injection Test ==="
log ""

# Step 1: Let peripherals initialize
emulation RunFor "00:00:00.000100"

# Step 2: Baseline — verify PWM IP Header
log "--- Baseline: PWM IP Header ---"
log "IP Header @ 0xF0003000 (expect 0x00080002):"
sysbus ReadDoubleWord 0xF0003000

# Step 3: Configure PWM normally
log ""
log "--- Normal Configuration ---"
log "Writing ClkDiv = 0x31 (49)..."
sysbus WriteDoubleWord 0xF0003010 0x31
emulation RunFor "00:00:00.000010"
log "ClkDiv    @ 0xF0003010 (expect 0x31):"
sysbus ReadDoubleWord 0xF0003010

log "Writing CH0 Period = 1000 (0x3E8)..."
sysbus WriteDoubleWord 0xF0003018 0x3E8
emulation RunFor "00:00:00.000010"
log "CH0 Period @ 0xF0003018 (expect 0x3E8):"
sysbus ReadDoubleWord 0xF0003018

log "Writing CH0 Pulse = 500 (0x1F4)..."
sysbus WriteDoubleWord 0xF000301C 0x1F4
emulation RunFor "00:00:00.000010"
log "CH0 Pulse @ 0xF000301C (expect 0x1F4):"
sysbus ReadDoubleWord 0xF000301C

log "Writing CH0 Enable = 1..."
sysbus WriteDoubleWord 0xF0003014 0x01
emulation RunFor "00:00:00.000010"
log "CH0 Ctrl  @ 0xF0003014 (expect 0x01):"
sysbus ReadDoubleWord 0xF0003014

# Step 4: Fault 1 — Corrupt R/W register (zero CH0 period)
log ""
log "--- Fault 1: R/W Register Corruption ---"
log "FAULT: Writing 0x00000000 to CH0 Period (was 0x3E8)..."
sysbus WriteDoubleWord 0xF0003018 0x00000000
emulation RunFor "00:00:00.000010"
log "CH0 Period @ 0xF0003018 (expect 0x00000000 — corrupted):"
sysbus ReadDoubleWord 0xF0003018
log "FINDING: CH0 period zeroed — firmware would not detect (no re-read)"

# Step 5: Fault 2 — Duty overflow (write >20-bit value)
log ""
log "--- Fault 2: Duty Overflow ---"
log "FAULT: Writing 0x001FFFFF (>20-bit max) to CH0 Pulse..."
sysbus WriteDoubleWord 0xF000301C 0x001FFFFF
emulation RunFor "00:00:00.000010"
log "CH0 Pulse @ 0xF000301C (observe RTL masking):"
sysbus ReadDoubleWord 0xF000301C

# Step 6: Fault 3 — RO register overwrite attempts
log ""
log "--- Fault 3: Read-Only Register Protection ---"
log "FAULT: Writing 0xDEADBEEF to IP Header (0xF0003000)..."
sysbus WriteDoubleWord 0xF0003000 0xDEADBEEF
emulation RunFor "00:00:00.000010"
log "IP Header  @ 0xF0003000 (expect still 0x00080002):"
sysbus ReadDoubleWord 0xF0003000

log "FAULT: Writing 0xDEADBEEF to IP Version (0xF0003004)..."
sysbus WriteDoubleWord 0xF0003004 0xDEADBEEF
emulation RunFor "00:00:00.000010"
log "IP Version @ 0xF0003004 (expect still 0x01000000):"
sysbus ReadDoubleWord 0xF0003004

log "FAULT: Writing 0xDEADBEEF to IP Features (0xF0003008)..."
sysbus WriteDoubleWord 0xF0003008 0xDEADBEEF
emulation RunFor "00:00:00.000010"
log "IP Features @ 0xF0003008 (expect still 0x14141402):"
sysbus ReadDoubleWord 0xF0003008

# Step 7: Verify isolation — corruption didn't spread
log ""
log "--- Isolation Check ---"
log "ClkDiv    @ 0xF0003010 (expect still 0x31 — no cross-register corruption):"
sysbus ReadDoubleWord 0xF0003010
log "CH0 Ctrl  @ 0xF0003014 (expect still 0x01 — still enabled):"
sysbus ReadDoubleWord 0xF0003014

log ""
log "=== PWM Fault Injection Test PASSED ==="
log ""

quit
