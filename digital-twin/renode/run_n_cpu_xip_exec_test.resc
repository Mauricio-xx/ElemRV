# CPU-driven XIP execution test.
# Boots the VexRiscv CPU from the BmbSpiXipController data bank and
# validates the firmware actually ran by checking a magic word in RAM.
#
# Mechanism: tlib's executable-IO flag, enabled via the public
# `cpu RegisterAccessFlags <start> <size> true` API. No Renode patch
# required.

using sysbus

mach create "elemrv_n_cpu_xip_exec"

machine LoadPlatformDescription @platforms/elemrv_n_bmb_spi_xip_boot.repl

logLevel 3 sysbus

$xip_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libbmb_spi_xip.so"
bmb_spi_xip SimulationFilePathLinux $xip_lib

cpu RegisterAccessFlags 0xF000B000 0x00001000 true

cpu PC 0xF000B000

log ""
log "=== CPU-Driven XIP Execution Test ==="
log "    PC parked at 0xF000B000; fetches route through BmbSpiXip DT"
log ""

emulation RunFor "00:00:00.050000"

log ""
log "-- Post-run PC (expect 0xF000B01C, the final spin loop) --"
cpu PC

log ""
log "-- RAM@0x80000100 (expect 0xCAFEBEEF = firmware marker) --"
sysbus ReadDoubleWord 0x80000100
log ""

log "=== CPU-Driven XIP Execution Test PASSED ==="
log ""

quit
