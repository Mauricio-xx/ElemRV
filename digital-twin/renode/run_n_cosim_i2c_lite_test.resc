# ElemRV-N I2C Lite Co-simulation Register Test
# Validates IpIdentification and clock divider register.
# No I2C slave connected — only register interface validated.

using sysbus

mach create "elemrv_n_cosim_i2c_lite"

machine LoadPlatformDescription @platforms/elemrv_n_cosim_i2c_lite.repl

logLevel 3 sysbus

$i2c_lite_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libi2c_lite.so"
i2c1_cosim SimulationFilePathLinux $i2c_lite_lib

sysbus WriteDoubleWord 0xA0000000 0x0000006F
cpu PC 0xA0000000
cpu PerformanceInMips 20

log ""
log "=== N I2C Lite Co-simulation Register Test ==="
log ""

emulation RunFor "00:00:00.000100"

# IpIdentification registers
log "IP Header    @ 0xF0002000:"
sysbus ReadDoubleWord 0xF0002000
log "IP Version   @ 0xF0002004:"
sysbus ReadDoubleWord 0xF0002004
log "IP Features  @ 0xF0002008:"
sysbus ReadDoubleWord 0xF0002008

# Write clock divider and read back
log "Writing clock divider = 0x64..."
sysbus WriteDoubleWord 0xF0002010 0x64
emulation RunFor "00:00:00.000010"
log "Clock Div    @ 0xF0002010 (expect 0x64):"
sysbus ReadDoubleWord 0xF0002010

log ""
log "=== N I2C Lite Co-simulation Test PASSED ==="
log ""

quit
