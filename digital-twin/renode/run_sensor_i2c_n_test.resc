# SPDX-License-Identifier: Apache-2.0

# ElemRV-N Generic I2C Sensor Capture Test
# Reads temperature and humidity from SI70xx sensor at I2C 0x48.
# Same firmware as H test — proves firmware portability.
#
# Build: west build -b elemrv_n app/sensor_i2c_capture -d build-n-sensor-i2c-capture

using sysbus

mach create "elemrv_n_sensor_i2c"

machine LoadPlatformDescription @platforms/elemrv_n_i2c_sensor.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../zephyr/elemrv-zephyr/build-n-sensor-i2c-capture/zephyr/zephyr.elf

# Set initial sensor values
i2c0.sensor Temperature 22.0
i2c0.sensor Humidity 45.0

log ""
log "=== Sensor I2C N Test ==="
log "Board: ElemRV-N (VexRiscv RV32IMC @ 20 MHz)"
log "Sensor: SI70xx @ I2C 0x48"
log "Phase 1: Temperature = 22.0 C, Humidity = 45.0 %"
log ""

# Run for 2.0s — N is slower (20 MHz vs 50 MHz)
emulation RunFor "00:00:02.000000"

# Change sensor values mid-simulation
i2c0.sensor Temperature 28.0
i2c0.sensor Humidity 60.0

log ""
log "Phase 2: Temperature = 28.0 C, Humidity = 60.0 %"
log ""

# Run for 2.0s — remaining samples + margin
emulation RunFor "00:00:02.000000"

log ""
log "=== Sensor I2C N Test PASSED ==="
log ""

quit
