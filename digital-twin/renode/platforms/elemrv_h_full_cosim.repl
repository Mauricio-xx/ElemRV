// ElemRV-H Full RTL Co-simulation Platform
// ALL 7 peripherals use Verilator co-simulation — cycle-accurate register fidelity.
// NOTE: UART console output (printk) will NOT work — serial lines are Verilator I/O.

cpu: CPU.VexRiscv @ sysbus
    cpuType: "rv32ic"

ram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x00002000

flash: Memory.MappedMemory @ sysbus 0xA0000000
    size: 0x00010000

// GPIO0: RTL Co-simulation @ 0xF0000000
gpio0_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0000000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000

// I2C0: RTL Co-simulation @ 0xF0001000
i2c0_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0001000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000

// PIO0: RTL Co-simulation @ 0xF0002000
pio0_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0002000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000

// PWM0: RTL Co-simulation @ 0xF0003000
pwm0_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0003000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000

// UART0: RTL Co-simulation @ 0xF0004000
uart0_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0004000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000

// Timer0: RTL Co-simulation @ 0xF0005000
timer0_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0005000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000

// Pinmux: RTL Co-simulation @ 0xF0010000
pinmux_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0010000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000
