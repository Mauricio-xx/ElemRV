// ElemRV-H Platform with I2C RTL Co-simulation

cpu: CPU.VexRiscv @ sysbus
    cpuType: "rv32ic"

ram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x00002000

flash: Memory.MappedMemory @ sysbus 0xA0000000
    size: 0x00010000

uart0: UART.LiteX_UART @ sysbus 0xF0004000
    -> cpu@0

gpio0: GPIOPort.LiteX_GPIO @ sysbus 0xF0000000
    type: Type.Out

// I2C0: RTL Co-simulation via Verilator (replaces LiteX_I2C)
i2c0_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0001000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000

timer0: Timers.LiteX_Timer @ sysbus 0xF0005000
    frequency: 50000000
    -> cpu@1

sysbus:
    init:
        Tag <0xF0003000, +0x1000> "PWM0"
        Tag <0xF0002000, +0x1000> "PIO0"
        Tag <0xF0010000, +0x1000> "Pinmux"
