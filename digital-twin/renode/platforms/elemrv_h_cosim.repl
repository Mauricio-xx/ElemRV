// ElemRV-H Co-simulation Platform Description
// Hydrogen platform with RTL co-simulation for PWM
// CPU: VexRiscv RV32IC @ 50 MHz

// CPU: RISC-V VexRiscv RV32IC
cpu: CPU.VexRiscv @ sysbus
    cpuType: "rv32ic"

// Main RAM: 8 KB @ 0x80000000
ram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x00002000

// FLASH: 64 KB @ 0xA0000000
flash: Memory.MappedMemory @ sysbus 0xA0000000
    size: 0x00010000

// UART0: LiteX UART @ 0xF0004000
uart0: UART.LiteX_UART @ sysbus 0xF0004000
    -> cpu@0

// GPIO0: 12 pins @ 0xF0000000
gpio0: GPIOPort.LiteX_GPIO @ sysbus 0xF0000000
    type: Type.Out

// I2C0: LiteX I2C @ 0xF0001000
i2c0: I2C.LiteX_I2C @ sysbus 0xF0001000

// Timer (for delays)
timer0: Timers.LiteX_Timer @ sysbus 0xF0005000
    frequency: 50000000
    -> cpu@1

// PWM0: RTL Co-simulation via Verilator
// Address: 0xF0003000, Size: 0x1000 (4KB)
pwm0_cosim: CoSimulated.CoSimulatedPeripheral @ sysbus <0xF0003000, +0x1000>
    frequency: 50000000
    limitBuffer: 10000

// PIO0 and Pinmux: Marked as unsupported (tagged for access logging)
sysbus:
    init:
        Tag <0xF0002000, +0x1000> "PIO0"
        Tag <0xF0010000, +0x1000> "Pinmux"
