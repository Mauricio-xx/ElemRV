# Multi-Peripheral Register Sequence Test
# Validates that programming multiple co-simulated peripherals in a single
# session causes no cross-corruption. Pure sysbus register access on
# elemrv_h_full_cosim.repl — all 7 peripherals via Verilator.

using sysbus

mach create "elemrv_h_multi_reg"

machine LoadPlatformDescription @platforms/elemrv_h_full_cosim.repl

logLevel 3 sysbus

# Attach all 7 verilated libraries
$gpio_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libgpio.so"
$i2c_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libi2c.so"
$pio_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libpio.so"
$pwm_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libpwm.so"
$uart_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libuart.so"
$mtimer_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libmtimer.so"
$pinmux_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libpinmux.so"
gpio0_cosim SimulationFilePathLinux $gpio_lib
i2c0_cosim SimulationFilePathLinux $i2c_lib
pio0_cosim SimulationFilePathLinux $pio_lib
pwm0_cosim SimulationFilePathLinux $pwm_lib
uart0_cosim SimulationFilePathLinux $uart_lib
timer0_cosim SimulationFilePathLinux $mtimer_lib
pinmux_cosim SimulationFilePathLinux $pinmux_lib

# Set CPU to tight loop (no firmware)
sysbus WriteDoubleWord 0xA0000000 0x0000006F
cpu PC 0xA0000000
cpu PerformanceInMips 50

log ""
log "=== Multi-Peripheral Register Sequence Test ==="
log "Validates no cross-corruption when programming multiple co-sim peripherals"
log ""

emulation RunFor "00:00:00.000100"

# --- Step 1: Write distinct values to Pinmux, PWM, and PIO ---
log "Step 1: Write distinct values to 3 peripherals"

# Pinmux pin 0 = 0x01 (select option 1)
log "  Pinmux pin 0 write 0x01..."
sysbus WriteDoubleWord 0xF0010000 0x01
emulation RunFor "00:00:00.000010"

# PWM clock divider (offset 0x10) = 0x31
log "  PWM clk_div write 0x31..."
sysbus WriteDoubleWord 0xF0003010 0x31
emulation RunFor "00:00:00.000010"

# PIO clock divider (offset 0x1C) = 0x42
log "  PIO clk_div write 0x42..."
sysbus WriteDoubleWord 0xF000201C 0x42
emulation RunFor "00:00:00.000010"

# --- Step 2: Read back all three — verify no cross-corruption ---
log "Step 2: Read back all three"

log "  Pinmux pin 0 (expect 0x01):"
sysbus ReadDoubleWord 0xF0010000

log "  PWM clk_div (expect 0x31):"
sysbus ReadDoubleWord 0xF0003010

log "  PIO clk_div (expect 0x42):"
sysbus ReadDoubleWord 0xF000201C

# --- Step 3: Write same register offset to PWM, PIO, GPIO — different values ---
log "Step 3: Write same-offset registers across PWM, PIO, GPIO"

# PWM offset 0x10 (clk_div) = 0xAA
log "  PWM @ 0xF0003010 write 0xAA..."
sysbus WriteDoubleWord 0xF0003010 0xAA
emulation RunFor "00:00:00.000010"

# PIO offset 0x1C (clk_div) = 0xBB
log "  PIO @ 0xF000201C write 0xBB..."
sysbus WriteDoubleWord 0xF000201C 0xBB
emulation RunFor "00:00:00.000010"

# GPIO offset 0x10 (direction register) = 0xCC
log "  GPIO @ 0xF0000010 write 0xCC..."
sysbus WriteDoubleWord 0xF0000010 0xCC
emulation RunFor "00:00:00.000010"

# --- Step 4: Read back all — verify each peripheral holds its own value ---
log "Step 4: Read back — each peripheral holds its own value"

log "  PWM @ 0xF0003010 (expect 0xAA):"
sysbus ReadDoubleWord 0xF0003010

log "  PIO @ 0xF000201C (expect 0xBB):"
sysbus ReadDoubleWord 0xF000201C

log "  GPIO @ 0xF0000010 (expect 0xCC):"
sysbus ReadDoubleWord 0xF0000010

# --- Step 5: Verify PWM not corrupted by PIO/GPIO writes ---
log "Step 5: Verify PWM IP Header unchanged after cross-peripheral writes"

log "  PWM IP Header @ 0xF0003000 (expect 0x00080002):"
sysbus ReadDoubleWord 0xF0003000

log ""
log "=== Multi-Peripheral Register Sequence Test PASSED ==="
log ""

quit
