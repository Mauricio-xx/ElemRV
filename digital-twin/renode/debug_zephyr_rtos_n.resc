# GDB Debug Session: ElemRV-N Zephyr RTOS Thread-Aware Debugging
#
# Usage:
#   Terminal 1: renode --disable-xwt --console -e "include @debug_zephyr_rtos_n.resc"
#   Terminal 2: riscv-none-elf-gdb -x gdb/elemrv.gdb zephyr/elemrv-zephyr/build-n-rtos-debug-demo/zephyr/zephyr.elf
#
# GDB commands (after connecting):
#   zephyr-threads  — List all threads (name, state, priority)
#   zephyr-stacks   — Show stack usage for all threads
#   zephyr-info     — Show available RTOS debug commands
#
# The rtos_debug_demo firmware creates 3 named threads (sensor, uart, gpio)
# plus main. All have CONFIG_DEBUG_THREAD_INFO=y for metadata visibility.

using sysbus

mach create "elemrv_n_rtos_debug"

machine LoadPlatformDescription @platforms/elemrv_n_zephyr.repl

logLevel 3 sysbus

showAnalyzer uart0

$elf ?= @../zephyr/elemrv-zephyr/build-n-rtos-debug-demo/zephyr/zephyr.elf
sysbus LoadELF $elf

machine StartGdbServer 3333 true

log "GDB server listening on port 3333 (ElemRV-N Zephyr RTOS debug)"
log "Board: ElemRV-N (VexRiscv RV32IMC @ 20 MHz)"
log "Connect with: riscv-none-elf-gdb -x gdb/elemrv.gdb <rtos_debug_demo.elf>"
log "Commands: zephyr-threads, zephyr-stacks, zephyr-info"
