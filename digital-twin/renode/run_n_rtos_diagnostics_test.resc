# ElemRV-N RTOS Diagnostics Test
# Runs rtos_diagnostics firmware on N (reduced config: no shell, no auto-analyzer).
# Validates on-demand thread_analyzer_print() output at 3s.
#
# Build: west build -b elemrv_n app/rtos_diagnostics -d build-n-rtos-diagnostics
#
# IMPORTANT (Renode v1.16.0 in Docker):
# - Use "emulation RunFor" with TimeSpan format
# - Do NOT use "cpu Execute" or "start" + RunFor

using sysbus

mach create "elemrv_n_rtos_diagnostics"

machine LoadPlatformDescription @platforms/elemrv_n_zephyr.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load RTOS diagnostics Zephyr ELF
sysbus LoadELF @../zephyr/elemrv-zephyr/build-n-rtos-diagnostics/zephyr/zephyr.elf

log ""
log "=== N RTOS Diagnostics Test ==="
log "Board: ElemRV-N (VexRiscv RV32IMC @ 20 MHz)"
log "App: rtos_diagnostics (on-demand analyzer, no shell on N)"
log ""

# Run for 5s — no auto-analyzer on N, just on-demand at 3s
emulation RunFor "00:00:05.000000"

log ""
log "=== N RTOS Diagnostics Test PASSED ==="
log ""

quit
