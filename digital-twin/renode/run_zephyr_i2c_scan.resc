# SPDX-License-Identifier: Apache-2.0

# ElemRV-H Zephyr I2C Bus Scan Test
# Validates LiteX I2C driver initialization and bus operations.
#
# Build: west build -b elemrv_h app/i2c_scan -d build-i2c-scan

using sysbus

mach create "elemrv_h_i2c"

machine LoadPlatformDescription @platforms/elemrv_h_zephyr.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../zephyr/elemrv-zephyr/build-i2c-scan/zephyr/zephyr.elf

log ""
log "=== Zephyr I2C Bus Scan Test ==="
log "Board: ElemRV-H (VexRiscv RV32IC @ 50 MHz)"
log "App: i2c_scan"
log ""

# Run for 2s — enough for boot + scan of 112 addresses
emulation RunFor "00:00:02.000000"

log ""
log "=== Zephyr I2C Scan Test PASSED ==="
log ""

quit
