# I2C Controller Co-simulation Register Test
# Validates IpIdentification and clock divider register.
# No I2C slave connected — only register interface validated.

using sysbus

mach create "elemrv_h_cosim_i2c"

machine LoadPlatformDescription @platforms/elemrv_h_cosim_i2c.repl

logLevel 3 sysbus

$i2c_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libi2c.so"
i2c0_cosim SimulationFilePathLinux $i2c_lib

sysbus WriteDoubleWord 0xA0000000 0x0000006F
cpu PC 0xA0000000
cpu PerformanceInMips 50

log ""
log "=== I2C Co-simulation Register Test ==="
log ""

emulation RunFor "00:00:00.000100"

# IpIdentification registers
log "IP Header    @ 0xF0001000:"
sysbus ReadDoubleWord 0xF0001000
log "IP Version   @ 0xF0001004:"
sysbus ReadDoubleWord 0xF0001004
log "IP Features  @ 0xF0001008:"
sysbus ReadDoubleWord 0xF0001008

# Write clock divider and read back
log "Writing clock divider = 0x64..."
sysbus WriteDoubleWord 0xF0001010 0x64
emulation RunFor "00:00:00.000010"
log "Clock Div    @ 0xF0001010 (expect 0x64):"
sysbus ReadDoubleWord 0xF0001010

log ""
log "=== I2C Co-simulation Test PASSED ==="
log ""

quit
