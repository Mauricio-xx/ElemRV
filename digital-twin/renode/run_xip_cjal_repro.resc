# Test 33j: Parameterized regression harness for the BmbSpiXip
# sub-word read fix (Gap 1). The firmware runs nine scenarios, each
# stressing the (addr & 3) shift path in bmb_spi_xip_wrapper.cpp for
# a different alignment/access-size combination. Each scenario writes
# its own marker slot in RAM on success; this driver asserts every
# slot and emits PASSED only if all match.
#
# Any mutation of the sub-word shift code (remove, flip sign, drop
# byte 1/3 path) manifests as at least one FAIL line below.

using sysbus

mach create "xip_cjal_repro"

machine LoadPlatformDescription @platforms/elemrv_n_bmb_spi_xip_boot.repl

logLevel 3 sysbus

$xip_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libbmb_spi_xip.so"
bmb_spi_xip SimulationFilePathLinux $xip_lib

cpu RegisterAccessFlags 0xF000B000 0x00001000 true

cpu PC 0xF000B000

log ""
log "=== XIP c.jal Sub-Word Regression Test ==="
log ""

emulation RunFor "00:00:05.000000"

python """
bus = monitor.Machine.SystemBus

def rd(addr):
    return bus.ReadDoubleWord(addr) & 0xFFFFFFFF

def check(label, got, expected):
    ok = (got == expected)
    mark = 'PASS' if ok else 'FAIL'
    print('[assert %s] %-42s got=0x%08X expected=0x%08X' %
          (mark, label, got, expected))
    return ok

all_ok = True
all_ok &= check('S1 overall end-of-firmware',   rd(0x80000100), 0xCAFEBEEF)
all_ok &= check('S2 c.jal -> word-aligned sub', rd(0x80000104), 0x5C110002)
all_ok &= check('S3 c.jal -> word+2 sub',       rd(0x80000108), 0x5C110003)
all_ok &= check('S4 jal at word+2 PC',          rd(0x8000010C), 0x5C110004)
all_ok &= check('S5 mixed C+uncomp arithmetic', rd(0x80000110), 0x5C110005)
all_ok &= check('S6 lw  XIP word+0',            rd(0x80000114), 0x5C110006)
all_ok &= check('S7 lhu XIP word+2',            rd(0x80000118), 0x5C110007)
all_ok &= check('S8 lbu XIP word+1',            rd(0x8000011C), 0x5C110008)
all_ok &= check('S9 lbu XIP word+3',            rd(0x80000120), 0x5C110009)

if all_ok:
    print('=== XIP c.jal Sub-Word Regression Test PASSED ===')
else:
    print('=== XIP c.jal Sub-Word Regression Test FAILED ===')
"""

quit
