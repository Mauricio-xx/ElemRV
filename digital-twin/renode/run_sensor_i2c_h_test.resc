# SPDX-License-Identifier: Apache-2.0

# ElemRV-H Generic I2C Sensor Capture Test
# Reads temperature and humidity from SI70xx sensor at I2C 0x48.
# Validates firmware reads 10 samples with changing values.
#
# Build: west build -b elemrv_h app/sensor_i2c_capture -d build-sensor-i2c-capture

using sysbus

mach create "elemrv_h_sensor_i2c"

machine LoadPlatformDescription @platforms/elemrv_h_i2c_sensor.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../zephyr/elemrv-zephyr/build-sensor-i2c-capture/zephyr/zephyr.elf

# Set initial sensor values
i2c0.sensor Temperature 22.0
i2c0.sensor Humidity 45.0

log ""
log "=== Sensor I2C H Test ==="
log "Board: ElemRV-H (VexRiscv RV32IC @ 50 MHz)"
log "Sensor: SI70xx @ I2C 0x48"
log "Phase 1: Temperature = 22.0 C, Humidity = 45.0 %"
log ""

# Run for 1.5s — Zephyr boot (~200ms) + first ~5 samples
emulation RunFor "00:00:01.500000"

# Change sensor values mid-simulation
i2c0.sensor Temperature 28.0
i2c0.sensor Humidity 60.0

log ""
log "Phase 2: Temperature = 28.0 C, Humidity = 60.0 %"
log ""

# Run for 1.5s — remaining samples + margin
emulation RunFor "00:00:01.500000"

log ""
log "=== Sensor I2C H Test PASSED ==="
log ""

quit
