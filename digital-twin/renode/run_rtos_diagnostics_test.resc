# SPDX-License-Identifier: Apache-2.0

# ElemRV-H RTOS Diagnostics Test
# Runs rtos_diagnostics firmware with thread analyzer (auto mode on H)
# and logging. Validates analyzer output + LOG_INF messages.
#
# Build: west build -b elemrv_h app/rtos_diagnostics -d build-rtos-diagnostics
#
# IMPORTANT (Renode v1.16.0 in Docker):
# - Use "emulation RunFor" with TimeSpan format
# - Do NOT use "cpu Execute" or "start" + RunFor

using sysbus

mach create "elemrv_h_rtos_diagnostics"

machine LoadPlatformDescription @platforms/elemrv_h_zephyr.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load RTOS diagnostics Zephyr ELF
sysbus LoadELF @../zephyr/elemrv-zephyr/build-rtos-diagnostics/zephyr/zephyr.elf

log ""
log "=== RTOS Diagnostics Test ==="
log "Board: ElemRV-H (VexRiscv RV32IC @ 50 MHz)"
log "App: rtos_diagnostics (auto thread analyzer + logging)"
log ""

# Run for 8s — enough for on-demand report at 3s + auto analyzer at 5s interval
emulation RunFor "00:00:08.000000"

log ""
log "=== RTOS Diagnostics Test PASSED ==="
log ""

quit
