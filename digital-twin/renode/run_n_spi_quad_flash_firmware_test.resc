# ElemRV-N bare-metal Quad I/O SPI flash test.
# Loads spi_quad_flash_test.bin at RAM start, runs the CPU, and checks
# that firmware drives the SPI co-sim controller + flash slave end-to-end
# to validate RDID and Quad I/O Fast Read via UART output.

using sysbus

mach create "elemrv_n_spi_quad_flash_fw"

machine LoadPlatformDescription @platforms/elemrv_n_cosim_spi_quad_flash.repl

logLevel 3 sysbus

$spi_lib?="/workspace/elemrv/digital-twin/renode/verilated/libs/libspi_quad.so"
spi0_cosim SimulationFilePathLinux $spi_lib

showAnalyzer uart0

sysbus LoadBinary @../renode/firmware/samples/spi_quad_flash_test/spi_quad_flash_test.bin 0x80000000
cpu PC 0x80000000
cpu PerformanceInMips 30

log ""
log "=== N SPI Quad Flash Bare-Metal Firmware Test ==="
log ""

emulation RunFor "00:00:01.000000"

log ""
log "=== N SPI Quad Flash Bare-Metal Firmware Done ==="
log ""

quit
