# SPDX-License-Identifier: Apache-2.0

# ElemRV-H Zephyr PIO Driver Test
# Validates custom WishbonePio driver via custom PIO API.
#
# Build: west build -b elemrv_h app/pio_test -d build-pio-test

using sysbus

mach create "elemrv_h_pio_zephyr"

machine LoadPlatformDescription @platforms/elemrv_h_zephyr.repl

# Suppress sysbus warnings for tagged regions
logLevel 3 sysbus

# Create UART analyzer to capture output
showAnalyzer uart0

# Load Zephyr ELF
sysbus LoadELF @../zephyr/elemrv-zephyr/build-pio-test/zephyr/zephyr.elf

log ""
log "=== Zephyr PIO Driver Test ==="
log "Board: ElemRV-H (VexRiscv RV32IC @ 50 MHz)"
log "App: pio_test"
log ""

# Run for 1s — PIO command submission is fast
emulation RunFor "00:00:01.000000"

log ""
log "=== Zephyr PIO Driver Test PASSED ==="
log ""

quit
