# Dockerfile for ElemRV Digital Twin simulation environment
# Includes: Renode 1.16.0, Verilator, RISC-V toolchain, Python3

FROM ubuntu:22.04

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies
RUN apt-get update && apt-get install -y \
    # Core build tools
    build-essential \
    git \
    wget \
    curl \
    ca-certificates \
    bison \
    flex \
    # Python
    python3 \
    python3-pip \
    python3-venv \
    # GTK dependencies (for Renode GUI)
    libgtk2.0-0 \
    libgtk2.0-dev \
    # Additional libraries
    libncurses5-dev \
    libexpat1-dev \
    libglib2.0-dev \
    libfdt-dev \
    libpixman-1-dev \
    zlib1g-dev \
    # Verilator dependencies
    libfl2 \
    libfl-dev \
    help2man \
    autoconf \
    # Java (for sbt/Scala)
    openjdk-11-jdk \
    # Utilities
    screen \
    uml-utilities \
    vim \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Set Python3 as default python
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Install Renode 1.16.0 (latest stable)
RUN wget -q https://github.com/renode/renode/releases/download/v1.16.0/renode-1.16.0.linux-portable.tar.gz \
    && tar -xzf renode-1.16.0.linux-portable.tar.gz -C /opt \
    && rm renode-1.16.0.linux-portable.tar.gz \
    && ln -sf /opt/renode_1.16.0_portable/renode /usr/local/bin/renode \
    && ln -sf /opt/renode_1.16.0_portable/renode-test /usr/local/bin/renode-test

# Install RISC-V GNU toolchain
RUN wget -q https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v13.2.0-2/xpack-riscv-none-elf-gcc-13.2.0-2-linux-x64.tar.gz \
    && tar -xzf xpack-riscv-none-elf-gcc-13.2.0-2-linux-x64.tar.gz -C /opt \
    && rm xpack-riscv-none-elf-gcc-13.2.0-2-linux-x64.tar.gz

# Add RISC-V toolchain to PATH
ENV PATH="/opt/xpack-riscv-none-elf-gcc-13.2.0-2/bin:${PATH}"

# Install sbt (Scala build tool)
RUN echo "deb https://repo.scala-sbt.org/scalasbt/debian all main" | tee /etc/apt/sources.list.d/sbt.list && \
    curl -sL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" | apt-key add - && \
    apt-get update && \
    apt-get install -y sbt && \
    rm -rf /var/lib/apt/lists/*

# Install Verilator 5.006 for RTL co-simulation
RUN git clone https://github.com/verilator/verilator /tmp/verilator \
    && cd /tmp/verilator \
    && git checkout v5.006 \
    && autoconf \
    && ./configure --prefix=/usr/local \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/verilator

# Install CMake 3.20+ (required by Zephyr)
RUN wget -q https://github.com/Kitware/CMake/releases/download/v3.28.3/cmake-3.28.3-linux-x86_64.tar.gz \
    && tar -xzf cmake-3.28.3-linux-x86_64.tar.gz -C /opt \
    && rm cmake-3.28.3-linux-x86_64.tar.gz
ENV PATH="/opt/cmake-3.28.3-linux-x86_64/bin:${PATH}"

# Install Zephyr SDK 0.17.0
RUN wget -q https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v0.17.0/zephyr-sdk-0.17.0_linux-x86_64_minimal.tar.xz \
    && tar -xf zephyr-sdk-0.17.0_linux-x86_64_minimal.tar.xz -C /opt \
    && rm zephyr-sdk-0.17.0_linux-x86_64_minimal.tar.xz \
    && cd /opt/zephyr-sdk-0.17.0 \
    && ./setup.sh -t riscv64-zephyr-elf -c
ENV ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdk-0.17.0

# Install Python packages (including west + Zephyr deps)
RUN pip3 install \
    pyserial \
    robotframework \
    pexpect \
    west \
    pyelftools \
    pyyaml \
    pykwalify \
    canopen \
    packaging \
    progress \
    psutil \
    anytree \
    intelhex

# Install device-tree compiler (required by Zephyr)
RUN apt-get update && apt-get install -y \
    device-tree-compiler \
    ninja-build \
    ccache \
    dfu-util \
    && rm -rf /var/lib/apt/lists/*

# Create workspace directory
WORKDIR /workspace

# Set environment variables
ENV RENODE_ROOT=/opt/renode_1.16.0_portable

# Default command
CMD ["/bin/bash"]
